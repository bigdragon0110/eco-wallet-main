# Backend API base URL used by the shop frontend. Use the LAN IP when the
# phone must talk to this machine over Wi-Fi (Trust Wallet QR flow).
REACT_APP_API_URL=http://192.168.2.12:3100

# Listen on all interfaces so the phone can reach the dev server.
HOST=0.0.0.0

# Public base URL the phone reaches when it opens the Tron deep-link QR.
# Must be reachable from the phone (LAN IP), never localhost.
REACT_APP_PUBLIC_URL=http://192.168.2.12:3000

# Required for the WalletConnect v2 QR sign-in ("Sign in with Trust Wallet (QR)").
# Get a free project ID at https://cloud.reown.com, then copy this file to .env
# and fill in the value. Without it the QR button shows a setup error.
REACT_APP_WALLETCONNECT_PROJECT_ID=1a63e5bb149be9275da7303437e5820f